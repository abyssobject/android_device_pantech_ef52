<?xml version="1.0" encoding="utf-8"?>
<!-- ef44: the VEGA Iron 2's BlackPT action bar (as in ef44_vega_about.xml:
     48dp, pt_ab_transparent_holo_dark, back arrow, 21dp #fafafa title), with
     room for one action button on the right (hidden until used) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ef44_ab"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/ef44_pt_ab_transparent_holo_dark">

    <LinearLayout
        android:id="@+id/ef44_ab_up"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/abc_action_bar_up_description"
        android:background="@drawable/ef44_pt_item_background_holo_dark">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="-4dp"
            android:src="@drawable/ef44_pt_ic_ab_back_holo_dark"
            android:importantForAccessibility="no" />
        <!-- ef52: the Iron 2 action bar's Settings gear after the up arrow -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:src="@drawable/ef44_vega_ab_settings"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/ef44_ab_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="21dp"
            android:textColor="#fffafafa" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/ef44_ab_action"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:visibility="gone"
        android:background="@drawable/ef44_pt_item_background_holo_dark" />
</LinearLayout>
