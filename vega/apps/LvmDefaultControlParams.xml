        <Value>LVM_PSA_SPEED_MEDIUM</Value>
    </PSA_PeakDecayRate>
    <PSA_NumBands>
        <Description>Sets the Number of spectral Bands to be calculated</Description>
        <Type>LVM_UINT16</Type>
        <Value>32</Value>
    </PSA_NumBands>
